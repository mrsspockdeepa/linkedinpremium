        <tr><td><strong>Agentic Job Search</strong></td><td>EV-1.1 to EV-1.6</td><td>EV-2.1, EV-2.4</td><td>EV-3.1, EV-3.4</td><td>—</td><td>EV-5.*</td><td>EV-6.*</td></tr>
        <tr><td><strong>Match Quality scoring</strong></td><td>EV-1.4</td><td>EV-2.1, EV-2.4, EV-2.5</td><td>EV-3.2</td><td>—</td><td>EV-5.*</td><td>EV-6.*</td></tr>
        <tr><td><strong>Sprint pricing &amp; cancel UX</strong></td><td>—</td><td>—</td><td>EV-3.3, EV-3.5</td><td>—</td><td>EV-5.*</td><td>EV-6.*</td></tr>
