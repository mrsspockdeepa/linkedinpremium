  &lt;div class=&quot;topbar&quot;&gt;
    &lt;div class=&quot;logo&quot;&gt;in&lt;/div&gt;
    &lt;h1&gt;Job Search Agent&lt;/h1&gt;
    &lt;div class=&quot;agent-status&quot;&gt;&lt;span class=&quot;pulse&quot;&gt;&lt;/span&gt; Agent active · Last run 12 min ago&lt;/div&gt;
  &lt;/div&gt;

  &lt;div class=&quot;container&quot;&gt;
    &lt;div class=&quot;hero&quot;&gt;
      &lt;h2&gt;Good morning, Alex.&lt;/h2&gt;
      &lt;p&gt;Your agent reviewed 2,341 new postings overnight and queued 5 actions for you.&lt;/p&gt;
      &lt;div class=&quot;hero-stats&quot;&gt;
        &lt;div class=&quot;hstat&quot;&gt;&lt;div class=&quot;num&quot;&gt;5&lt;/div&gt;&lt;div class=&quot;lbl&quot;&gt;Actions today&lt;/div&gt;&lt;/div&gt;
        &lt;div class=&quot;hstat&quot;&gt;&lt;div class=&quot;num&quot;&gt;12&lt;/div&gt;&lt;div class=&quot;lbl&quot;&gt;Apps in flight&lt;/div&gt;&lt;/div&gt;
        &lt;div class=&quot;hstat&quot;&gt;&lt;div class=&quot;num&quot;&gt;3&lt;/div&gt;&lt;div class=&quot;lbl&quot;&gt;Interviews&lt;/div&gt;&lt;/div&gt;
        &lt;div class=&quot;hstat&quot;&gt;&lt;div class=&quot;num&quot;&gt;62&lt;/div&gt;&lt;div class=&quot;lbl&quot;&gt;Days in sprint&lt;/div&gt;&lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;

    &lt;div class=&quot;card&quot;&gt;
      &lt;h3&gt;Today&#x27;s action queue&lt;/h3&gt;

      &lt;div class=&quot;action&quot;&gt;
        &lt;div class=&quot;icon icon-blue&quot;&gt;📝&lt;/div&gt;
        &lt;div class=&quot;body&quot;&gt;
          &lt;strong&gt;Review tailored application — Senior PM at Stripe&lt;/strong&gt;
          &lt;p&gt;Agent drafted a resume tailored to the JD (highlights payments + experimentation work) and a 3-paragraph cover letter referencing their 2025 acquirer launch.&lt;/p&gt;
          &lt;div class=&quot;meta&quot;&gt;92% match · Posted 2 days ago · Closes in 12 days&lt;/div&gt;
        &lt;/div&gt;
        &lt;button class=&quot;btn&quot;&gt;Review &amp;amp; submit&lt;/button&gt;
      &lt;/div&gt;

      &lt;div class=&quot;action&quot;&gt;
        &lt;div class=&quot;icon icon-green&quot;&gt;🤝&lt;/div&gt;
        &lt;div class=&quot;body&quot;&gt;
          &lt;strong&gt;Approve referral request — Figma&lt;/strong&gt;
          &lt;p&gt;Marcus K. (2nd-degree, Design Lead at Figma) is connected to your former coworker. Drafted a warm referral request mentioning your shared connection and Figma&#x27;s recent dev mode launch.&lt;/p&gt;
          &lt;div class=&quot;meta&quot;&gt;Group PM role · 87% match · Marcus has accepted 4 of last 6 requests&lt;/div&gt;
        &lt;/div&gt;
        &lt;button class=&quot;btn&quot;&gt;Approve &amp;amp; send&lt;/button&gt;
      &lt;/div&gt;

      &lt;div class=&quot;action&quot;&gt;
        &lt;div class=&quot;icon icon-amber&quot;&gt;⚡&lt;/div&gt;
        &lt;div class=&quot;body&quot;&gt;
          &lt;strong&gt;Skill gap detected: SQL for product analytics&lt;/strong&gt;
          &lt;p&gt;3 of your top 10 target roles list SQL as required. A 4-hour LinkedIn Learning path could close this gap and auto-update your verified skills.&lt;/p&gt;
          &lt;div class=&quot;meta&quot;&gt;Could unlock ~14 additional matched roles&lt;/div&gt;
        &lt;/div&gt;
        &lt;button class=&quot;btn&quot;&gt;Start path&lt;/button&gt;
      &lt;/div&gt;

      &lt;div class=&quot;action&quot;&gt;
        &lt;div class=&quot;icon icon-blue&quot;&gt;🎯&lt;/div&gt;
        &lt;div class=&quot;body&quot;&gt;
          &lt;strong&gt;Interview prep ready — Notion (Thursday 2pm)&lt;/strong&gt;
          &lt;p&gt;Your interviewer Sara H. recently posted about async-first product orgs. Generated 8 likely questions, her hiring history, and suggested talking points.&lt;/p&gt;
          &lt;div class=&quot;meta&quot;&gt;Principal PM · Round 2 of 4&lt;/div&gt;
        &lt;/div&gt;
        &lt;button class=&quot;btn&quot;&gt;Open prep doc&lt;/button&gt;
      &lt;/div&gt;

      &lt;div class=&quot;action&quot;&gt;
        &lt;div class=&quot;icon icon-green&quot;&gt;💰&lt;/div&gt;
        &lt;div class=&quot;body&quot;&gt;
          &lt;strong&gt;Negotiation coaching — Linear offer received&lt;/strong&gt;
          &lt;p&gt;Their offer ($245k base, $80k equity) is 8% below the median for Principal PMs at Series C startups in NYC. Drafted a counter at $268k base with rationale.&lt;/p&gt;
          &lt;div class=&quot;meta&quot;&gt;Salary data: 247 verified comp records&lt;/div&gt;
        &lt;/div&gt;
        &lt;button class=&quot;btn&quot;&gt;Open coach&lt;/button&gt;
      &lt;/div&gt;
    &lt;/div&gt;

    &lt;div class=&quot;card&quot;&gt;
      &lt;h3&gt;Recent agent activity&lt;/h3&gt;
      &lt;div class=&quot;timeline-item&quot;&gt;&lt;div class=&quot;time&quot;&gt;12 min ago&lt;/div&gt;Scanned 2,341 new postings · matched 18 to your criteria&lt;/div&gt;
      &lt;div class=&quot;timeline-item&quot;&gt;&lt;div class=&quot;time&quot;&gt;2 hr ago&lt;/div&gt;Sent referral request to Jamie L. at Stripe (your approval)&lt;/div&gt;
      &lt;div class=&quot;timeline-item&quot;&gt;&lt;div class=&quot;time&quot;&gt;Yesterday&lt;/div&gt;Application submitted to Linear · Principal PM&lt;/div&gt;
      &lt;div class=&quot;timeline-item&quot;&gt;&lt;div class=&quot;time&quot;&gt;2 days ago&lt;/div&gt;Updated your resume with new &quot;Verified: SQL&quot; skill&lt;/div&gt;
    &lt;/div&gt;

    &lt;div class=&quot;card&quot;&gt;
      &lt;h3&gt;Agent autonomy settings&lt;/h3&gt;
      &lt;div class=&quot;toggle-row&quot;&gt;&lt;span&gt;Auto-draft tailored resumes &amp;amp; cover letters&lt;/span&gt;&lt;div class=&quot;switch&quot;&gt;&lt;/div&gt;&lt;/div&gt;
      &lt;div class=&quot;toggle-row&quot;&gt;&lt;span&gt;Auto-submit applications (requires my approval)&lt;/span&gt;&lt;div class=&quot;switch&quot;&gt;&lt;/div&gt;&lt;/div&gt;
      &lt;div class=&quot;toggle-row&quot;&gt;&lt;span&gt;Auto-send referral requests without approval&lt;/span&gt;&lt;div class=&quot;switch off&quot;&gt;&lt;/div&gt;&lt;/div&gt;
      &lt;div class=&quot;toggle-row&quot;&gt;&lt;span&gt;Daily action digest at 8:00 AM&lt;/span&gt;&lt;div class=&quot;switch&quot;&gt;&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/body&gt;
